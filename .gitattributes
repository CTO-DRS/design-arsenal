# Exclude development/CI infrastructure from release archives (git archive,
# and the "Source code (zip)" assets GitHub auto-attaches to releases).
# The v2.0.0 release asset is the installable bundle only.
.github export-ignore
tools export-ignore
build export-ignore
bundle export-ignore

# README demo GIF is a display asset only (README + GitHub Pages) —
# keep the installable release archive lean; no need inside the skill bundle.
demo/assets/demo.gif export-ignore
